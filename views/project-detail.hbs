<section class="section page-hero">
  <div class="container">
    <a href="/projects" class="back-link">← Back to Projects</a>
    <div class="proj-icon-xl">{{project.icon}}</div>
    <h1 class="page-title">{{project.title}}</h1>
    <div class="tag-row" style="margin-top:16px;">
      {{#each project.stack}}
      <span class="tag tag-{{lookup ../project.stackColors @index}}">{{this}}</span>
      {{/each}}
    </div>
  </div>
</section>
<section class="section">
  <div class="container detail-grid">
    <div class="detail-main animate">
      <h2 class="detail-section-title">About this project</h2>
      <p class="detail-desc">{{project.description}}</p>
      <h2 class="detail-section-title" style="margin-top:32px;">Key Features</h2>
      <ul class="highlights-list">
        {{#each project.highlights}}
        <li class="highlight-item"><span class="hi-arrow">→</span> {{this}}</li>
        {{/each}}
      </ul>
    </div>
    <div class="detail-sidebar animate">
      <div class="sidebar-card">
        <h3 class="sidebar-title">Tech Stack</h3>
        {{#each project.stack}}
        <div class="sidebar-tech"><span class="tech-dot"></span> {{this}}</div>
        {{/each}}
      </div>
      {{#if project.github}}
      <a href="{{project.github}}" target="_blank" class="btn btn-primary sidebar-btn">View on GitHub →</a>
      {{/if}}
    </div>
  </div>
</section>
