    </div>
    <div class="hero-card animate">
      <div class="hero-card-top"></div>
      <div class="avatar-ring">FK</div>
      <div class="avatar-name">Francis Kativarapu</div>
      <div class="avatar-title">AI/ML · Python · Node.js</div>
      <div class="avatar-stats">
        <div class="stat-item"><div class="stat-num">4</div><div class="stat-label">Projects</div></div>
        <div class="stat-item"><div class="stat-num">7+</div><div class="stat-label">Tech</div></div>
        <div class="stat-item"><div class="stat-num">∞</div><div class="stat-label">Passion</div></div>
      </div>
      <div class="tag-cloud">
        <span class="tag">PyTorch</span>
        <span class="tag">BERT</span>
        <span class="tag">Python</span>
        <span class="tag">Flask</span>
        <span class="tag">Node.js</span>
        <span class="tag">MySQL</span>
      </div>
    </div>
  </div>
</section>

<!-- FEATURED PROJECT -->
<section class="section bg-alt">
  <div class="container">
    <div class="sec-header animate">
      <div class="sec-label">Featured Work</div>
      <h2 class="sec-title">Latest <span class="muted">Project</span></h2>
    </div>
    <div class="featured-card animate">
      <div class="featured-badge">★ Featured Project</div>
      <div class="feat-top">
        <div class="proj-icon-lg">🤖</div>
        <a href="/projects/1" class="btn btn-outline btn-sm">View Details →</a>
      </div>
      <h3 class="feat-title">BERT Sentiment Analysis – Multi-GPU Training</h3>
      <p class="feat-desc">Fine-tuned a BERT transformer model for 3-class sentiment classification using PyTorch with multi-GPU DataParallel support, AdamW optimiser, and custom Dataset/DataLoader pipeline. Trained over 3 epochs with full loss &amp; accuracy visualisation.</p>
      <div class="tag-row">
        <span class="tag">PyTorch</span>
        <span class="tag">BERT</span>
        <span class="tag tag-green">HuggingFace</span>
        <span class="tag tag-green">scikit-learn</span>
        <span class="tag tag-orange">pandas</span>
        <span class="tag tag-orange">matplotlib</span>
      </div>
    </div>
  </div>
</section>

<!-- ALL PROJECTS PREVIEW -->
<section class="section">
  <div class="container">
    <div class="sec-header animate">
      <div class="sec-label">What I've Built</div>
      <h2 class="sec-title">All <span class="muted">Projects</span></h2>
    </div>
    <div class="projects-grid">
      {{#each projects}}
      <div class="project-card animate">
        <div class="proj-top">
          <div class="proj-icon">{{icon}}</div>
          <a href="/projects/{{id}}" class="proj-link">→</a>
        </div>
        <h3 class="proj-title">{{title}}</h3>
        <p class="proj-desc">{{description}}</p>
        <div class="tag-row">
          {{#each stack}}
          <span class="tag tag-{{lookup ../stackColors @index}}">{{this}}</span>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- SKILLS -->
<section class="section bg-alt">
  <div class="container">
    <div class="sec-header animate">
      <div class="sec-label">My Stack</div>
      <h2 class="sec-title">Skills <span class="muted">Overview</span></h2>
    </div>
    <div class="skills-grid">
      {{#each skills}}
      <div class="skill-card animate">
        <div class="skill-cat-title"><span class="skill-icon">{{icon}}</span> {{category}}</div>
        <div class="skill-list">
          {{#each items}}
          <div class="skill-row">
            <span class="skill-name">{{name}}</span>
            <div class="skill-bar"><div class="skill-fill" style="width:{{level}}%"></div></div>
            <span class="skill-pct">{{level}}%</span>
          </div>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section">
  <div class="container cta-section animate">
    <h2 class="cta-title">Ready to <span class="accent">collaborate</span>?</h2>
    <p class="cta-sub">Let's build something great together.</p>
    <a href="/contact" class="btn btn-primary btn-lg">Get In Touch →</a>
  </div>
</section>
